rules_version = '2';

// Firestore rules for the TCE Food Court app.
//
// Deploy manually (nothing in this repo deploys rules automatically):
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Menu is public so it can be read before signing in.
    match /menu_items/{itemId} {
      allow read: if true;
      // Only the Firebase console / Admin SDK (bypasses rules) manages the menu.
      allow write: if false;
    }

    // A user profile document for the signed-in user.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(userId)
                    && request.resource.data.email
                       == resource.data.email;
      allow delete: if false;
    }

    // Orders live under the owning user, so no user can read or write another's.
    // The document shape matches `Order.toMap()` in lib/models/order.dart.
    match /users/{userId}/orders/{orderId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.data.total is number
                    && request.resource.data.total > 0
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0;
      allow update: if isOwner(userId)
                    && request.resource.data.items == resource.data.items
                    && request.resource.data.total == resource.data.total;
      allow delete: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
  }
}
